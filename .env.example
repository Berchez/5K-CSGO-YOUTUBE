# HLTV
HLTV_MATCHES_URL=https://www.hltv.org/matches
# Piso de estrelas para a partida entrar no monitoramento (0-5).
# 0 = sem filtro: toda partida live é monitorada (necessário p/ o 5k sem estrela).
MIN_STARS=0
# Mínimo de kills em partidas com pelo menos 1 estrela (4 = 4k/5k).
MIN_KILLS=4
# Mínimo de kills em partidas SEM estrela no listing (5 = só ace).
MIN_KILLS_NO_STARS=5
# Atraso do placar live do HLTV vs jogo real (ms). O corte começa
# (1º kill observado - isto - 10s de contexto). Suba se o clipe começar
# DEPOIS da 1ª kill; desça se começar muito antes. Default: 10000
# O mesmo atraso desconta os timestamps da descrição (o `at` da kill é o
# momento em que o placar a mostrou, não o instante do kill).
SCOREBOARD_DELAY_MS=10000
# Só top-tier? true filtra eventos big/Major; false aceita qualquer com MIN_STARS
TOP_TIER_ONLY=false
# Intervalo base entre checagens do listing (ms). Com o poll adaptativo
# este valor só vale quando o bot está ativo (live/gravação) ou perto do
# horário da próxima partida; ocioso, o bot espera metade do tempo que
# falta (teto de 30min) para não abrir a página do HLTV sem necessidade.
POLL_INTERVAL_MS=45000
# Poll adaptativo: true = ocioso espera metade do tempo que falta para a
# próxima partida elegível (teto 30min); false = sempre no intervalo base
# (comportamento antigo). Kill switch do recurso.
# Aceita true/false e também 1/0 (1 liga, 0 desliga).
POLL_ADAPTIVE=true
# Fechar o browser (headed) durante a espera ociosa: true = libera RAM/CPU,
# mas o relançamento no poll seguinte pode piscar na tela (foco em jogo
# fullscreen). false = mantém o browser aberto.
HLTV_CLOSE_BROWSER_IDLE=true
# Espera mínima (ms) para fechar o browser ocioso. Espera curta não
# compensa fechar/relançar. 0 = fecha em qualquer espera ociosa.
HLTV_CLOSE_BROWSER_MIN_IDLE_MS=600000

# Recorder (PC local Windows)
# Mantém captura separada (vídeo/áudio HLS atuais) e, quando disponível,
# a melhor variante muxed da fonte sem limite de resolução/FPS. Isso duplica
# aproximadamente o uso de rede/disco por partida.
# Prioridade: official,en | "gaules" grava a transmissão do Gaules (PT-BR).
# Fallback cruzado automático: a escolhida indisponível usa a outra
# (sem Gaules no ar => oficial; sem oficial no ar => Gaules).
STREAM_PRIORITY=official,en
# País preferido (código da bandeira HLTV, ex: BR). Vazio = desligado.
# Só escolhe esse país se tiver STREAM_PREFERRED_MIN_VIEWERS ou mais.
STREAM_PREFERRED_COUNTRY=
STREAM_PREFERRED_MIN_VIEWERS=0
MAX_RECORDINGS=2
BUFFER_DIR=./data/buffer
SEGMENT_TIME_SEC=10
# Mantém últimos N segmentos em cada variante capturada
# (SEGMENT_TIME_SEC * SEGMENT_WRAP ≈ janela de cada buffer)
# 240s: cobre round longo (~140s) + contexto + espera do fim ancorado
SEGMENT_WRAP=24
# Quanto salvar antes/depois do 5º kill
CLIP_PRE_ROLL_SEC=60
CLIP_POST_ROLL_SEC=15
# Contexto antes do 1º kill do ace (o clipe começa aqui; default 10)
CLIP_CONTEXT_SEC=10
# Contexto quando a âncora é incerta (tracker entrou no meio do round):
# começa mais cedo para não perder a abertura real (default 25)
CLIP_CONTEXT_UNCERTAIN_SEC=25
# Replay-aware (Fase 1: shadow): shadow mede/loga o fim com replay sem
# aplicar; off pula; on reservado à Fase 2 (age como shadow por enquanto)
REPLAY_AWARE=shadow
# Fim do clipe: segundos após a virada do placar do round (default 8).
CLIP_END_AFTER_CLOSE_SEC=8
# Ancora o fim do clipe na virada do placar do round no vídeo (OCR do topo).
# auto aplica quando encontra a transição; log só mede; off desliga.
CLIP_STREAM_SYNC=auto
CLIP_STREAM_SYNC_MAX_LAG_SEC=120
# Crop normalizado x:y:w:h do placar no topo do vídeo.
CLIP_SCOREBOARD_CROP=0.30:0.03:0.40:0.10
# Cauda extra quando o placar não é encontrado (fallback seguro).
CLIP_STREAM_SYNC_FALLBACK_SEC=35
# Upscale p/ forçar VP9/AV1 no YouTube (1440/2160; 0 = desligado)
CLIP_UPSCALE_HEIGHT=1440
# Auto-sync A/V por conteúdo: auto (mede e aplica só com evidência confiável,
# default), log (mede sem corrigir) ou off (pula a medição).
CLIP_AV_SYNC=auto
# Correção A/V ESTÁTICA em ms (0 = desligado): atrasa o áudio sempre neste
# valor, com precedência sobre o auto. Calibração manual p/ skew sistemático
# conhecido quando a medição automática não decide (gameplay denso). NÃO é
# global seguro (varia por stream): sete durante o evento, volte a 0 depois.
AV_STATIC_OFFSET_MS=0
# Escopo do estático: matchIds com vírgula (ex: "2399233,2399204").
# Vazio = global (aplica em tudo — perigoso). Fluxo: confirme o skew numa
# variante (npm run fix:av), escopete o match, volte o offset a 0 no fim.
AV_STATIC_MATCHES=
# Offset por STREAM (canal estável no log "gravando buffer"): calibre UMA
# vez por canal (variante + ouvido) e todos os clipes dele saem corrigidos
# sem revisão por clipe. Ex: "ESL TV=2000,Gaules=0". Tem precedência abaixo
# do MATCHES. Restart do transcode no meio do clipe marca offsetUnverified
# no sidecar (spot-check, não revisão total).
AV_STREAM_OFFSETS=
# Fluxo de calibragem por canal (offset re-rola a cada restart do transcode):
# 1. npm run fix:av -- <clipe.mp4> 1500 --ms 2000 --ms 2500 (variantes)
# 2. assista, escolha o delay vencedor
# 3. npm run av:calibrate -- --stream "ESL TV" --ms 2000 (vale p/ a sessão)
# 4. restart invalida sozinho (offsetUnverified no sidecar) → recalibrar
CLIPS_DIR=./data/clips
# Espaço livre mínimo em disco (GB): abaixo disto o render aborta com erro
# claro (em vez de mp4 corrompido sem moov) e o recorder avisa. Default 3.
DISK_MIN_FREE_GB=3

# Estado / logs
DB_PATH=./data/bot.sqlite
LOG_FILE=./logs/bot.log
LOG_LEVEL=info

# YouTube (sempre private no MVP para revisão)
# YT_UPLOAD=false gera o clipe e mantém local, sem fazer upload
YT_UPLOAD=true
YT_PRIVACY=private
YT_CLIENT_SECRETS=./client_secrets.json
YT_TOKEN_PATH=./token.json
YT_CATEGORY_ID=20
YT_DEFAULT_TAGS=cs2,ace,5k,counter-strike,highlights

# Título e descrição (metadados) dos vídeos futuros:
# ai = IA escreve criativo em PT-BR (com guarda anti-alucinação) e cai no
#      gerador determinístico se a IA falhar ou inventar algo;
# template = gerador determinístico (offline, instantâneo, nunca fixa);
# legacy = título/descrição fixos de antes (kill switch).
YT_META_MODE=ai
# Ordem dos providers de TEXTO: o 1º é preferido, o resto é fallback.
YT_META_AI_ORDER=gemini,huggingface
# Timeout por provider de texto (ms).
YT_META_AI_TIMEOUT_MS=45000
YT_META_GEMINI_MODEL=gemini-3-flash-preview
YT_META_HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# Assinatura do canal: vira hashtag no fim da descrição (ex.: 5K CS).
YT_BRAND=
# Linha extra (CTA) no fim da descrição.
YT_DESC_CTA=

# Thumbnails: composed (grátis, default) ou ai (cadeia de fallback, cai p/ composed no fim)
THUMB_MODE=composed
# CADEIA DE FALLBACK: o 1º é o preferido; se falhar (cota/login/timeout/challenge),
# cai para o próximo. Esgotada a cadeia → thumb composta determinística (sharp, US$0).
# Providers: chatgpt > grok > gemini-web > huggingface (token) > gemini (pago) > pollinations
# chatgpt/grok geram a thumb COMPLETA (layout do canal); os outros só o fundo (overlay sharp por cima).
THUMB_AI_ORDER=chatgpt,gemini-web
# Timeout por provider IA (ms, default 600000 = 10min): render web às vezes passa de 5min
THUMB_AI_TIMEOUT_MS=600000
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# gemini-web (Playwright no app Gemini, experimental): perfil com login manual.
# Use conta DESCARTÁVEL (nunca a dona do canal). Login 1x via: npx tsx scripts/gemini-login.ts
GEMINI_WEB_PROFILE=./data/gemini-profile
# Perfil do Chrome dentro do user-data-dir (ex.: "Profile 2"). Vazio = default do Chromium.
GEMINI_WEB_CHROME_PROFILE=
# 1 = headless (default). Use 0 para o perfil persistente ser lido corretamente.
GEMINI_WEB_HEADLESS=1
# chatgpt (Playwright no app ChatGPT, experimental): mesma regra da conta descartável.
# Login 1x via: npx tsx scripts/chatgpt-login.ts
# Janela sempre MINIMIZADA (sem popup em jogo fullscreen). 0 = visível (se challenge implicar).
CHATGPT_PROFILE=./data/chatgpt-profile
CHATGPT_MINIMIZED=1
# grok (Playwright no app Grok, experimental): conta X descartável.
# Login 1x via: npx tsx scripts/grok-login.ts
GROK_PROFILE=./data/grok-profile
GROK_MINIMIZED=1
