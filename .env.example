# HLTV
HLTV_MATCHES_URL=https://www.hltv.org/matches
# Piso de estrelas para a partida entrar no monitoramento (0-5).
# 0 = sem filtro: toda partida live é monitorada (necessário p/ o 5k sem estrela).
MIN_STARS=0
# Mínimo de kills em partidas com pelo menos 1 estrela (4 = 4k/5k).
MIN_KILLS=4
# Mínimo de kills em partidas SEM estrela no listing (5 = só ace).
MIN_KILLS_NO_STARS=5
# Atraso do placar live do HLTV vs jogo real (ms). Default: 5000
# O placar mostra o kill alguns segundos DEPOIS dele acontecer. O corte
# converte a âncora para a timeline do vídeo (CLIP_STREAM_LATENCY_MS) e
# os timestamps da descrição usam (latência - este valor).
# ATENÇÃO: para o INÍCIO do clipe, a cobertura e os timestamps, só a
# diferença (CLIP_STREAM_LATENCY_MS - SCOREBOARD_DELAY_MS) importa — os
# dois valores não são identificáveis separadamente. Calibre a
# diferença (o log "latência observada" mostra a diferença medida).
SCOREBOARD_DELAY_MS=5000
# Atraso do VÍDEO gravado vs jogo real (ms). O recorder consome HLS: o
# conteúdo chega ~20-30s depois de ter acontecido, e o mtime do segmento
# marca QUANDO o arquivo foi escrito. Sem esta correção o clipe abre no
# round ANTERIOR (antes da 1ª kill). Default: 25000 (medido ~20s).
# O log "latência observada da stream" mede o valor real de cada canal.
CLIP_STREAM_LATENCY_MS=25000
# Latência por CANAL (ms), quando a fonte entrega o material com outro
# atraso: JSON {"Gaules": 22000, "ESL TV": 30000}. Vazio = todos usam
# CLIP_STREAM_LATENCY_MS. O nome é o da stream no log "gravando buffer muxed".
# Exemplo medido (2399756, PGL Masters 2026): gaules entregou com 45s —
# com o global de 25s o clipe abria ~20s antes da 1ª kill (round anterior).
# ATENÇÃO: um valor ACIMA de CLIP_START_LATENCY_MAX_MS só vale depois que
# o canal tiver MEDIÇÃO (o log "latência observada" avisa quando ela
# existe); sem medição, a abertura usa o teto.
CLIP_STREAM_LATENCY_BY_STREAM=
# Atraso com que o placar do HLTV publica o PLACAR FINAL do round (ms).
# A coluna K reflete cada kill rápido, mas o placar da partida só vira
# depois do round fechar — é esse atraso que ancora o FIM do clipe.
# Default: 20000
CLIP_SCORE_DELAY_MS=20000
# Só top-tier? true filtra eventos big/Major; false aceita qualquer com MIN_STARS
TOP_TIER_ONLY=false
# Intervalo base entre checagens do listing (ms). Com o poll adaptativo
# este valor só vale quando o bot está ativo (live/gravação) ou perto do
# horário da próxima partida; ocioso, o bot espera metade do tempo que
# falta (teto de 30min) para não abrir a página do HLTV sem necessidade.
POLL_INTERVAL_MS=45000
# Poll adaptativo: true = ocioso espera metade do tempo que falta para a
# próxima partida elegível (teto 30min); false = sempre no intervalo base
# (comportamento antigo). Kill switch do recurso.
# Aceita true/false e também 1/0 (1 liga, 0 desliga).
POLL_ADAPTIVE=true
# Fechar o browser (headed) durante a espera ociosa: true = libera RAM/CPU,
# mas o relançamento no poll seguinte pode piscar na tela (foco em jogo
# fullscreen). false = mantém o browser aberto.
HLTV_CLOSE_BROWSER_IDLE=true
# Espera mínima (ms) para fechar o browser ocioso. Espera curta não
# compensa fechar/relançar. 0 = fecha em qualquer espera ociosa.
HLTV_CLOSE_BROWSER_MIN_IDLE_MS=600000

# Recorder (PC local Windows)
# Captura ÚNICA: a melhor variante combinada (muxed) da fonte, na resolução/
# FPS da própria fonte (sem teto artificial). Sem fonte combinada a partida
# é ignorada (sem gravação e sem clipe) — nunca há captura separada nem
# vídeo não muxed.
# Seletor de formato do yt-dlp para a fonte COMBINADA. Default: best.
# É o kill-switch da camada de captura (ex.: 'best[height<=1080]' para uma
# fonte cuja melhor variante é pesada demais). NÃO use 'bv*' (vídeo
# separado): dois inputs trazem o skew A/V de volta.
CAPTURE_FORMAT=best
# Prioridade: official,en | "gaules" grava a transmissão do Gaules (PT-BR).
# Fallback cruzado automático: a escolhida indisponível usa a outra
# (sem Gaules no ar => oficial; sem oficial no ar => Gaules).
STREAM_PRIORITY=official,en
# País preferido (código da bandeira HLTV, ex: BR). Vazio = desligado.
# Só escolhe esse país se tiver STREAM_PREFERRED_MIN_VIEWERS ou mais.
STREAM_PREFERRED_COUNTRY=
STREAM_PREFERRED_MIN_VIEWERS=0
MAX_RECORDINGS=2
BUFFER_DIR=./data/buffer
SEGMENT_TIME_SEC=10
# Mantém últimos N segmentos no buffer
# (SEGMENT_TIME_SEC * SEGMENT_WRAP ≈ janela do buffer)
# 240s: cobre round longo (~140s) + contexto + espera do fim ancorado
SEGMENT_WRAP=24
# Quanto salvar antes/depois do 5º kill
CLIP_PRE_ROLL_SEC=60
CLIP_POST_ROLL_SEC=15
# Contexto antes do 1º kill do ace (o clipe começa aqui; default 10)
CLIP_CONTEXT_SEC=10
# Contexto quando a âncora é incerta (tracker entrou no meio do round):
# começa mais cedo para não perder a abertura real (default 25)
CLIP_CONTEXT_UNCERTAIN_SEC=25
# Margem EXTRA antes da 1ª kill (o clipe começa CLIP_CONTEXT_SEC +
# CLIP_START_MARGIN_SEC antes dela). O erro de latência é assimétrico:
# latência real MENOR que a configurada deixa a 1ª kill FORA do clipe;
# latência real maior só abre o clipe mais cedo (material extra). A
# margem paga o erro pelo lado barato. Default: 5
CLIP_START_MARGIN_SEC=5
# Teto da latência de ABERTURA do clipe. Só age quando o canal NÃO tem
# medição (aí a latência configurada é um palpite): o clipe abre mais
# cedo (material do round anterior) em vez de começar depois da 1ª kill
# — o pior defeito. Com medição do canal (placar/killfeed) o valor
# medido vale inteiro: o teto não mexe em medição.
# O teto NÃO altera os timestamps nem a cobertura — só a abertura.
# Inativo com CLIP_STREAM_SYNC_ADAPTIVE=false ou CLIP_STREAM_SYNC=log.
# Default: 25000. 0 = desligado.
CLIP_START_LATENCY_MAX_MS=25000
# Upscale do clipe live (opcional): 0 = desligado (resolução nativa da
# fonte), 1440/2160 = reescala na mesma passada do encode (denoise +
# scale + sharpen). Serve para forçar VP9/AV1 no YouTube (que entrega
# 1080p em AV1/H.264). CUSTA CPU (1440p60 satura o encode) — por isso
# é opt-in. Default: 0
CLIP_UPSCALE_HEIGHT=0
# Replay-aware: corta o clipe antes da AÇÃO do round seguinte (o fim
# ancorado caía no replay/freeze e deixava dezenas de segundos de cauda).
# auto (default) aplica com folga; on aplica com qualquer sobreposição;
# shadow só mede/loga; off pula a detecção.
REPLAY_AWARE=auto
# Fim do clipe: segundos após a virada do placar do round (default 8).
CLIP_END_AFTER_CLOSE_SEC=8
# Fim do clipe ESTIMADO (sem âncora do OCR no vídeo): cauda extra (s).
# O fim estimado depende da latência configurada — se a stream real
# atrasar MAIS, o corte fecha antes do round e perde a última kill.
# Default: 8 (somando com CLIP_END_AFTER_CLOSE_SEC).
CLIP_END_TAIL_SEC=8
# Sanidade do fim lido no OCR do vídeo: se ele estiver MUITO depois do
# fim estimado, o placar lido é o do round seguinte (overlay ilegível na
# tela de fim/replay) e a âncora é descartada. Default: 60 (0 desliga)
CLIP_END_PLAUSIBILITY_SEC=60
# Ancora o fim do clipe na virada do placar do round no vídeo (OCR do topo).
# auto aplica quando encontra a transição; log só mede; off desliga.
CLIP_STREAM_SYNC=auto
CLIP_STREAM_SYNC_MAX_LAG_SEC=120
# Congela o buffer antes dos OCRs (default auto): o anel não pode reescrever
# a abertura do round enquanto o placar/killfeed são lidos. off = snapshot
# tardio (comportamento antigo, sujeito à rotação do buffer).
CLIP_FREEZE=auto
# Cobertura estrita: descarta o ace quando a 1ª kill não está no material —
# só com evidência forte (posição exata do killfeed fora do buffer ou régua
# que prove ausência). "OCR não leu o nome" NÃO descarta (nomes truncados
# são comuns). Default: true
CLIP_COVERAGE_STRICT=true
# Crop normalizado x:y:w:h do placar no topo do vídeo.
CLIP_SCOREBOARD_CROP=0.30:0.03:0.40:0.10
# TEMPO extra de espera quando a transição do placar não é encontrada (o
# material precisa chegar). NÃO afeta o corte (o fim sai de
# CLIP_END_TAIL_SEC). Default 35.
CLIP_STREAM_SYNC_FALLBACK_SEC=35
CLIPS_DIR=./data/clips
# Espaço livre mínimo em disco (GB): abaixo disto o render aborta com erro
# claro (em vez de mp4 corrompido sem moov) e o recorder avisa. Default 3.
DISK_MIN_FREE_GB=3

# Shorts verticais (9:16) para o feed Shorts do YouTube.
# O material é 16:9 (transmissão da HLTV): o 9:16 é produzido no RENDER
# (crop central + scale), nunca na captura. Os Shorts saem pelo script
# `npm run publish:shorts` (o clip 16:9 do bot continua igual).
# Publicar exige esta chave ligada (o dry-run funciona sem ela).
# SHORTS_ENABLED=false
# Duração máxima do Short (o YouTube aceita até 3min; 60s é o corte).
SHORTS_MAX_SEC=90
# Duração mínima (abaixo disso o Short é rápido demais e perde retenção).
# Tem que ser MENOR ou igual a SHORTS_MAX_SEC (o painel recusa o resto).
SHORTS_MIN_SEC=60
# Folga antes da 1ª kill (o gancho) e depois da última kill.
SHORTS_HEAD_SEC=4
SHORTS_TAIL_SEC=4
# Saída do vertical (1080x1920 = 9:16). A LARGURA tem que ser menor que
# a altura.
SHORTS_WIDTH=1080
SHORTS_HEIGHT=1920
# Onde os verticais, os markers e o relatório são gravados.
SHORTS_DIR=./data/shorts
# Posição horizontal do crop: 0 = esquerda, 0.5 = centro, 1 = direita.
# O crop 9:16 tira ~2/3 da largura do 16:9 — se a ação ou o placar
# saírem do quadro, mova aqui.
SHORTS_CROP_X=0.5
# Legenda QUEIMADA no Short (o texto entra no próprio mp4, via libass).
# `on` transcreve o áudio da janela do Short com a IA (1 chamada por
# Short) e grava a legenda na vertical; `off` sai sem legenda.
# A transcrição usa o GEMINI_API_KEY (traduz para PT-BR quando o áudio
# não é português); o Whisper do HuggingFace (HF_TOKEN) é a reserva.
SHORTS_CAPTIONS=true
# Ordem dos providers de transcrição (gemini,huggingface,whisper-cpp).
# whisper-cpp usa o modelo local de .tools/models/ggml e não gasta cota.
SHORTS_CAPTION_AI_ORDER=gemini,huggingface
# Modelo ggml do whisper.cpp local (em .tools/models/ggml).
SHORTS_CAPTION_WHISPER_MODEL=large-v3-turbo-q5_0
# Modelo dedicado de transcrição (Interactions API): é a reserva quando a
# cota do Gemini de TEXTO acaba — a cota dele é outra.
SHORTS_CAPTION_DEDICATED_MODEL=gemini-3.5-transcribe
# O silêncio de um provider é final? on = sim (o provider local não é
# chamado depois: sem VAD ele inventa fala no silêncio); off = o próximo
# provider é consultado (um falso-negativo não mata a legenda).
SHORTS_CAPTION_SILENCE_FINAL=true
# Passe revisor da legenda: segunda chamada corrige nome/termo de CS sem
# reescrever a fala. Desligue para economizar cota do Gemini.
SHORTS_CAPTION_REFINE=true
# Traduz a legenda para PT-BR quando o streamer fala outra língua (o
# original fica em <name>_legenda.orig.txt). Se a tradução FALHAR (ou não
# houver tradutor), o Short SEGURA (não vai ao ar com a legenda no idioma
# original); se não havia o que traduzir (fala só de nome/gíria), o Short
# segue.
SHORTS_CAPTION_TRANSLATE=true
# Onde a legenda fica: below-crosshair = um pouco abaixo da mira do
# player (centro da área do jogo); game-top = logo abaixo da cam;
# bottom = rodapé.
SHORTS_CAPTION_POSITION=below-crosshair
# Tamanho da fonte da legenda (px, na saída de 1080 de largura).
SHORTS_CAPTION_FONT_SIZE=54
# Família da fonte. O padrão (Barlow Condensed) vem do repo, em
# assets/fonts — o libass a acha pelo fontsdir e a legenda sai igual em
# toda máquina. Outra família precisa estar instalada no Windows.
SHORTS_CAPTION_FONT_FAMILY=Barlow Condensed
# Mínimo de kills para virar Short (o bot também grava 3K/4K).
SHORTS_MIN_KILLS=3
# Visibilidade do Short: unlisted = testa sem risco de claim no canal.
SHORTS_PRIVACY=unlisted
# Hashtag de classificação do Short — ENTRE ASPAS: solta, o `#` vira
# comentário no .env e a hashtag chega vazia.
SHORTS_HASHTAG="#Shorts"

# Estado / logs
DB_PATH=./data/bot.sqlite
LOG_FILE=./logs/bot.log
LOG_LEVEL=info

# YouTube (sempre private no MVP para revisão)
# YT_UPLOAD=false gera o clipe e mantém local, sem fazer upload
YT_UPLOAD=true
YT_PRIVACY=private
YT_CLIENT_SECRETS=./client_secrets.json
YT_TOKEN_PATH=./token.json
YT_CATEGORY_ID=20
YT_DEFAULT_TAGS=cs2,ace,5k,counter-strike,highlights

# Título e descrição (metadados) dos vídeos futuros:
# ai = IA escreve criativo em PT-BR (com guarda anti-alucinação) e cai no
#      gerador determinístico se a IA falhar ou inventar algo;
# template = gerador determinístico (offline, instantâneo, nunca fixa);
# legacy = título/descrição fixos de antes (kill switch).
YT_META_MODE=ai
# Ordem dos providers de TEXTO: o 1º é preferido, o resto é fallback.
YT_META_AI_ORDER=gemini,huggingface
# Timeout por provider de texto (ms).
YT_META_AI_TIMEOUT_MS=45000
YT_META_GEMINI_MODEL=gemini-3-flash-preview
YT_META_HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# Assinatura do canal: vira hashtag no fim da descrição (ex.: 5K CS).
YT_BRAND=
# Linha extra (CTA) no fim da descrição.
YT_DESC_CTA=

# Thumbnails: composed (grátis, default) ou ai (cadeia de fallback, cai p/ composed no fim)
THUMB_MODE=composed
# CADEIA DE FALLBACK: o 1º é o preferido; se falhar (cota/login/timeout/challenge),
# cai para o próximo. Esgotada a cadeia → thumb composta determinística (sharp, US$0).
# Providers: chatgpt > grok > gemini-web > huggingface (token) > gemini (pago) > pollinations
# chatgpt/grok geram a thumb COMPLETA (layout do canal); os outros só o fundo (overlay sharp por cima).
THUMB_AI_ORDER=chatgpt,gemini-web
# Timeout por provider IA (ms, default 600000 = 10min): render web às vezes passa de 5min
THUMB_AI_TIMEOUT_MS=600000
# Thumb COMPOSTA (default 1): a IA gera só o FUNDO e a montagem local (sharp)
# faz retrato do jogador, logos, mapa e textos (texto nunca alucinado).
# O chatgpt ignora esta flag — a thumb dele já é completa (rosto+textos na imagem).
THUMB_COMPOSITE=1
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# --- Transcrição de áudio (legendas SRT/VTT/TXT) ---
# Provider padrão do adapter (scripts/transcribe.ts). O Short de referência
# usou Gemini; locais: faster-whisper, whisper-cpp, vosk. Nuvem: gemini,
# openai, groq, deepgram, assemblyai, elevenlabs.
TRANSCRIPTION_PROVIDER=gemini
# Vazio = modelo padrão do provider (ver src/transcription/registry.ts).
TRANSCRIPTION_MODEL=
# auto = detectar; pt/en/es... força o idioma.
TRANSCRIPTION_LANGUAGE=auto
# VAD local (faster-whisper/whisper.cpp): pula silêncio.
TRANSCRIPTION_VAD=true
TRANSCRIPTION_TIMEOUT_MS=600000
TRANSCRIPTION_OUTPUT_FORMAT=srt
# Vazio = .tools/py312 (venv Python 3.12 do faster-whisper/Vosk).
TRANSCRIPTION_PYTHON=
# Chaves dos providers de nuvem (vazio = "requer setup" no --list).
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
# gemini-web (Playwright no app Gemini, experimental): perfil com login manual.
# Use conta DESCARTÁVEL (nunca a dona do canal). Login 1x via: npx tsx scripts/gemini-login.ts
GEMINI_WEB_PROFILE=./data/gemini-profile
# Perfil do Chrome dentro do user-data-dir (ex: "Profile 2"). Vazio = default do Chromium.
GEMINI_WEB_CHROME_PROFILE=
# Headless (ligado por padrão). Desligado = o perfil persistente é lido
# corretamente. Aceita true/false e 1/0.
GEMINI_WEB_HEADLESS=true
# chatgpt (Playwright no app ChatGPT, experimental): mesma regra da conta descartável.
# Login 1x via: npx tsx scripts/chatgpt-login.ts
CHATGPT_PROFILE=./data/chatgpt-profile
# Janela sempre MINIMIZADA (sem popup em jogo fullscreen). Desligado = visível
# (se o challenge implicar). Aceita true/false e 1/0.
CHATGPT_MINIMIZED=true
# grok (Playwright no app Grok, experimental): conta X descartável.
# Login 1x via: npx tsx scripts/grok-login.ts
GROK_PROFILE=./data/grok-profile
# Idem CHATGPT_MINIMIZED.
GROK_MINIMIZED=true
