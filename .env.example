# HLTV
HLTV_MATCHES_URL=https://www.hltv.org/matches
# Mínimo de estrelas para considerar o jogo importante (0-5). Configurável.
MIN_STARS=4
# Só top-tier? true filtra eventos big/Major; false aceita qualquer com MIN_STARS
TOP_TIER_ONLY=false
POLL_INTERVAL_MS=45000

# Recorder (PC local Windows)
# Prioridade: official,en | Ex: "official,en" prefere stream oficial em inglês
STREAM_PRIORITY=official,en
MAX_RECORDINGS=2
BUFFER_DIR=./data/buffer
SEGMENT_TIME_SEC=10
# Mantém últimos N segmentos (SEGMENT_TIME_SEC * SEGMENT_WRAP ≈ janela do buffer)
SEGMENT_WRAP=18
# Quanto salvar antes/depois do 5º kill
CLIP_PRE_ROLL_SEC=60
CLIP_POST_ROLL_SEC=15
# Contexto antes do 1º kill do ace (o clipe começa aqui; live ancora no kill real)
CLIP_CONTEXT_SEC=10
CLIPS_DIR=./data/clips

# Estado / logs
DB_PATH=./data/bot.sqlite
LOG_FILE=./logs/bot.log
LOG_LEVEL=info

# YouTube (sempre private no MVP para revisão)
YT_PRIVACY=private
YT_CLIENT_SECRETS=./client_secrets.json
YT_TOKEN_PATH=./token.json
YT_CATEGORY_ID=20
YT_DEFAULT_TAGS=cs2,ace,5k,counter-strike,highlights

# Thumbnails: composed (grátis, default) ou ai (cadeia de fallback, cai p/ composed no fim)
THUMB_MODE=composed
# CADEIA DE FALLBACK: o 1º é o preferido; se falhar (cota/login/timeout/challenge),
# cai para o próximo. Esgotada a cadeia → thumb composta determinística (sharp, US$0).
# Providers: chatgpt > grok > gemini-web > huggingface (token) > gemini (pago) > pollinations
# chatgpt/grok geram a thumb COMPLETA (layout do canal); os outros só o fundo (overlay sharp por cima).
THUMB_AI_ORDER=chatgpt,gemini-web
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# gemini-web (Playwright no app Gemini, experimental): perfil com login manual.
# Use conta DESCARTÁVEL (nunca a dona do canal). Login 1x via: npx tsx scripts/gemini-login.ts
GEMINI_WEB_PROFILE=./data/gemini-profile
# chatgpt (Playwright no app ChatGPT, experimental): mesma regra da conta descartável.
# Login 1x via: npx tsx scripts/chatgpt-login.ts
# Janela sempre VISÍVEL por geração (minimizada = challenge). 1 = tenta minimizada.
CHATGPT_PROFILE=./data/chatgpt-profile
CHATGPT_MINIMIZED=0
# grok (Playwright no app Grok, experimental): conta X descartável.
# Login 1x via: npx tsx scripts/grok-login.ts
GROK_PROFILE=./data/grok-profile
GROK_MINIMIZED=0
